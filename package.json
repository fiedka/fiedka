{
  "name": "fiedka",
  "productName": "fiedka",
  "version": "1.5.2",
  "description": "Fiedka the Firmware Editor",
  "main": ".webpack/main",
  "scripts": {
    "storybook": "TS_NODE_PROJECT='./.storybook/tsconfig.json' storybook dev --ci --port 6006",
    "start": "GOPATH=$(pwd) GOROOT=$(go env GOROOT) electron-forge start",
    "package": "GOPATH=$(pwd) GOROOT=$(go env GOROOT) electron-forge package",
    "make": "GOPATH=$(pwd) GOROOT=$(go env GOROOT) electron-forge make",
    "publish": "GOPATH=$(pwd) GOROOT=$(go env GOROOT) electron-forge publish",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "check": "biome check src/",
    "format": "biome format --write src/",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiedka/fiedka.git"
  },
  "keywords": [
    "App",
    "Firmware",
    "x86",
    "AMD",
    "Intel",
    "Editor",
    "UEFI"
  ],
  "author": {
    "name": "Daniel Maslowski",
    "email": "info@orangecms.org"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/orangecms/utk-web/issues"
  },
  "homepage": "https://fiedka.app/",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@electron-forge/cli": "^8.0.0-alpha.10",
    "@electron-forge/maker-deb": "^8.0.0-alpha.10",
    "@electron-forge/maker-dmg": "^8.0.0-alpha.10",
    "@electron-forge/maker-rpm": "^8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "^8.0.0-alpha.10",
    "@electron-forge/maker-zip": "^8.0.0-alpha.10",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "^8.0.0-alpha.10",
    "@electron-forge/plugin-webpack": "^8.0.0-alpha.10",
    "@electron-forge/publisher-github": "^8.0.0-alpha.10",
    "@electron/fuses": "^2.1.3",
    "@fiedka/golang-wasm-async-loader": "^5.0.0",
    "@storybook/addon-actions": "^8.2.9",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/addon-webpack5-compiler-swc": "^1.0.5",
    "@storybook/react": "^8.2.9",
    "@storybook/react-webpack5": "^8.2.9",
    "@vercel/webpack-asset-relocator-loader": "^1.11.0",
    "@wasm-tool/wasm-pack-plugin": "^1.7.0",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "electron": "^44.4.5",
    "file-loader": "^6.2.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "jest": "^30.5.2",
    "node-loader": "^2.1.0",
    "storybook": "^8.2.9",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.14",
    "@coalmines/indui": "^1.6.0",
    "@reduxjs/toolkit": "^1.9.7",
    "classnames": "^2.3.2",
    "electron-squirrel-startup": "^1.0.1",
    "joi": "^17.11.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.0.5",
    "redux": "^4.2.1",
    "styled-jsx": "^5.1.2",
    "use-file-picker": "^2.1.0"
  }
}
